rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Validation Blueprint for HouseholdUser (matches firebase-blueprint.json)
    function isValidHouseholdUser(data, userId) {
      return data.keys().hasAll([
        'uid',
        'email',
        'householdName',
        'country',
        'stateRegion',
        'members',
        'homeType',
        'sizeM2',
        'unitSystem',
        'currency',
        'language',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'email',
        'householdName',
        'country',
        'stateRegion',
        'members',
        'homeType',
        'sizeM2',
        'unitSystem',
        'currency',
        'language',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string &&
      data.uid.size() >= 1 &&
      data.uid.size() <= 128 &&
      data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == request.auth.uid &&
      data.uid == userId &&
      data.email is string &&
      data.email.size() >= 3 &&
      data.email.size() <= 160 &&
      data.householdName is string &&
      data.householdName.size() >= 1 &&
      data.householdName.size() <= 100 &&
      data.country is string &&
      data.country.size() >= 1 &&
      data.country.size() <= 40 &&
      data.stateRegion is string &&
      data.stateRegion.size() >= 1 &&
      data.stateRegion.size() <= 80 &&
      data.members is number &&
      data.members >= 1 &&
      data.members <= 25 &&
      data.homeType is string &&
      data.homeType.size() <= 32 &&
      (
        data.homeType == 'Apartment' ||
        data.homeType == 'Detached House' ||
        data.homeType == 'Row Home' ||
        data.homeType == 'Villa' ||
        data.homeType == 'Rural Homestead'
      ) &&
      data.sizeM2 is number &&
      data.sizeM2 >= 10 &&
      data.sizeM2 <= 10000 &&
      data.unitSystem is string &&
      data.unitSystem.size() <= 16 &&
      (data.unitSystem == 'metric' || data.unitSystem == 'imperial') &&
      data.currency is string &&
      data.currency.size() >= 3 &&
      data.currency.size() <= 8 &&
      data.language is string &&
      data.language.size() >= 2 &&
      data.language.size() <= 8 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidHouseholdUser(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidHouseholdUser(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'email',
            'householdName',
            'country',
            'stateRegion',
            'members',
            'homeType',
            'sizeM2',
            'unitSystem',
            'currency',
            'language',
            'updatedAt'
          ])
        );

      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
